rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /admins/{uid} { allow read: if owner(uid); allow write: if false; }  // add tutors by hand in the console

    match /settings/public { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/class  { allow read, write: if isAdmin(); }                // holds { code: "YOURCODE" }

    match /students/{uid} {
      allow read: if owner(uid) || isAdmin();
      // a student profile can only be created with the right class code
      allow create: if owner(uid)
        && request.resource.data.classCode == get(/databases/$(db)/documents/settings/class).data.code;
      allow update: if owner(uid) && request.resource.data.classCode == resource.data.classCode;

      match /progress/{id} { allow read, write: if owner(uid); allow read: if isAdmin(); }
      match /drafts/{id}   { allow read, write: if owner(uid); allow read: if isAdmin(); }
      match /free/{id}     { allow read, create: if owner(uid); allow read: if isAdmin(); }
      match /reviews/{id}  { allow read: if owner(uid) || isAdmin(); allow write: if isAdmin(); }
    }
  }
}
